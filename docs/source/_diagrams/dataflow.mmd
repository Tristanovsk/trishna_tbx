flowchart LR
    subgraph main["Input main data"]
        IN1["Sentinel-2 L1C<br/>SAFE or NetCDF subsets"]
        IN2["GRS L2A<br/>NetCDF time series"]
        IN3["In situ Rrs<br/>HYPERNETS, AERONET-OC"]
    end

    subgraph aux["Input auxiliary data"]
        AUX1["CAMS<br/>AOT, TCWV, O3"]
        AUX2["Sensor models<br/>TRISHNA SRF/SNR, S2 SRF"]
        AUX3["OWT references, gas LUT,<br/>solar spectrum<br/>(GRSl2bgen, radcalnet_oc)"]
    end

    EMU["Emulation<br/>trishna_tbx.emulate<br/>bands, 60 m, SBAF, noise"]
    AC["Atmospheric correction<br/>grs (TRISHNA band set)"]
    SIM["TOA simulation<br/>trishna_tbx.simulate<br/>(radcalnet_oc)"]
    L2B["Water products<br/>algorithms, owt,<br/>inversion, water_vapor"]

    subgraph out["Output data"]
        OUT1["TRISHNA-like L1C / L2A<br/>xarray.Dataset"]
        OUT2["Products and OWT<br/>S2 vs TRISHNA"]
        OUT3["Assessment tables<br/>validation statistics"]
    end

    IN1 --> EMU --> AC --> OUT1
    IN2 --> EMU
    AUX1 --> AC
    AUX2 --> EMU
    IN3 --> SIM
    AUX3 --> SIM
    AUX3 --> L2B
    OUT1 --> L2B --> OUT2
    SIM --> L2B
    IN3 --> OUT3
    OUT2 --> OUT3

    %% mid-grey arrows, visible on the light and dark themes
    linkStyle default stroke:#8a8a8a,stroke-width:2px

    classDef mainStyle fill:#3d85c6,stroke:#1c4587,stroke-width:2px,color:#ffffff
    classDef auxStyle fill:#8e7cc3,stroke:#4a2d84,stroke-width:2px,color:#ffffff
    classDef procStyle fill:#e69138,stroke:#a35a00,stroke-width:3px,color:#ffffff,font-weight:bold
    classDef outStyle fill:#6aa84f,stroke:#274e13,stroke-width:2px,color:#ffffff
    classDef groupStyle fill:#f3f3f3,stroke:#999999,stroke-dasharray: 4 3,color:#333333

    class IN1,IN2,IN3 mainStyle
    class AUX1,AUX2,AUX3 auxStyle
    class EMU,AC,SIM,L2B procStyle
    class OUT1,OUT2,OUT3 outStyle
    class main,aux,out groupStyle
